# Use `make setup` to generate .env with fresh secrets. Do not copy these values.
POSTGRES_PASSWORD=
SHERLOCK_ENCRYPTION_KEY=
SHERLOCK_SETUP_TOKEN=
SHERLOCK_ORIGIN=http://localhost:8080
SHERLOCK_PORT=8080
# Optional webhook exceptions, separate from telemetry network policy.
SHERLOCK_NOTIFICATION_HOSTS=
SHERLOCK_NOTIFICATION_CIDRS=
SHERLOCK_NOTIFICATION_HTTP_HOSTS=
